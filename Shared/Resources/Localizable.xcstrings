      }
    },
    "Photos use your Claude key" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos usan tu clave de Claude"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos utilisent ta clé Claude"
          }
        }
      }
    },
    "Photos you scan go to Anthropic's Claude, which sends back the calories and macros. About 2 cents a photo, billed to your Anthropic account. Your log never leaves your phone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que escaneas se envían a Claude, de Anthropic, que devuelve las calorías y los macros. Unos 2 céntimos por foto, facturados a tu cuenta de Anthropic. Tu registro nunca sale de tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos que tu scannes partent chez Claude, d’Anthropic, qui renvoie les calories et les macros. Environ 2 centimes par photo, facturés sur ton compte Anthropic. Ton journal ne quitte jamais ton téléphone."
          }
        }
      }
    },
    "Photos you scan go to Bite's server and on to Google's Gemini, which sends back the calories and macros. No photo is kept. With your own Claude key, photos go to Anthropic instead, billed to your Anthropic account. Your log never leaves your phone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que escaneas pasan por el servidor de Bite y después por Gemini de Google, que devuelve las calorías y los macros. No se guarda ninguna foto. Con tu propia clave de Claude, las fotos van a Anthropic, con cargo a tu cuenta de Anthropic. Tu diario nunca sale de tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos que tu scannes passent par le serveur de Bite puis par Gemini de Google, qui renvoie les calories et les macros. Aucune photo n’est gardée. Avec ta propre clé Claude, les photos vont plutôt chez Anthropic, facturées sur ton compte Anthropic. Ton journal ne quitte jamais ton téléphone."
          }
        }
      }
    },
