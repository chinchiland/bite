    "Your goal" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton objectif"
          }
        }
      }
    },
    "Your goal already counts a normal week. Turn this on if you picked Mostly sitting, so workouts give you room to eat more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo ya cuenta con una semana normal. Actívalo si elegiste «Casi siempre sentado», así tus entrenamientos te dejan comer más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton objectif tient déjà compte d’une semaine normale. Active cette option si tu as choisi « Plutôt assis », pour que tes séances te laissent manger plus."
          }
        }
      }
    },
    "Your goal already counts a normal week. Turn this on if you picked Mostly sitting, so workouts give you room to eat more. What Bite reads is in the iPhone's Settings: Privacy & Security, Health, Bite." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo ya cuenta con una semana normal. Actívalo si elegiste «Casi siempre sentado», así tus entrenamientos te dejan comer más. Lo que lee Bite se cambia en los Ajustes del iPhone: Privacidad y seguridad, Salud, Bite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton objectif tient déjà compte d’une semaine normale. Active cette option si tu as choisi « Plutôt assis », pour que tes séances te laissent manger plus. Ce que Bite lit se règle dans les Réglages de l’iPhone : Confidentialité et sécurité, Santé, Bite."
          }
        }
      }
    },
    "Your goal is now %@ kcal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
