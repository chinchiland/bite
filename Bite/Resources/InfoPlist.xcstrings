{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bite uses the camera to scan barcodes, photograph your meals and take your mirror photos, which stay on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite usa la cámara para escanear códigos de barras, fotografiar tus comidas y hacer las fotos de tu espejo, que se quedan en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite utilise l’appareil photo pour scanner les codes-barres, photographier tes repas et prendre les photos de ton miroir, qui restent sur ce téléphone."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Face ID keeps your mirror photos for your eyes only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protege las fotos de tu espejo de otras miradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protège les photos de ton miroir des autres regards."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bite shows your steps, the calories you burn and your weight next to what you eat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite muestra tus pasos, las calorías que quemas y tu peso junto a lo que comes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite affiche tes pas, les calories que tu brûles et ton poids à côté de ce que tu manges."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you turn it on, Bite saves the meals you log to Apple Health, with their calories and nutrients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo activas, Bite guarda en la app Salud las comidas que anotas, con sus calorías y nutrientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu l’actives, Bite enregistre les repas que tu notes dans l’app Santé, avec leurs calories et nutriments."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bite uses your location to list the restaurants and cafes around you when you add a meal. It stays on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite usa tu ubicación para listar los restaurantes y cafeterías a tu alrededor cuando añades una comida. Solo la ve Mapas de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bite utilise ta position pour lister les restaurants et cafés autour de toi quand tu ajoutes un repas. Seule l’app Plans d’Apple la voit."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
